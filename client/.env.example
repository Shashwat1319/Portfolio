# EmailJS — powers the contact form (https://dashboard.emailjs.com)
# Copy this file to `.env`, fill in the values, then restart `npm run dev`.
# Vite only exposes variables prefixed with VITE_ to the browser.

VITE_EMAILJS_SERVICE_ID=service_xxxxxxxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx
